{
  "manifest_version": 3,
  "name": "AnimeTab",
  "version": "1.1.2",
  "description": "Beautiful anime wallpapers, clock, and daily quotes every time you open a new tab.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://nekos.best/*",
    "https://images.unsplash.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
