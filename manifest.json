{
  "manifest_version": 3,
  "name": "AnimeTab",
  "version": "1.4.0",
  "description": "Beautiful anime wallpapers, clock, daily quotes, airing countdowns, and curated merch every time you open a new tab.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://nekos.best/*",
    "https://wallhaven.cc/*",
    "https://graphql.anilist.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
