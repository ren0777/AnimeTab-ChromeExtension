{
  "name": "animetab",
  "version": "1.6.3",
  "description": "AnimeTab — Anime New Tab with Wallpapers, Clock, Quotes, Merch & Airing Countdown",
  "main": "src/index.jsx",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "clean": "rimraf dist",
    "lint": "eslint --ext .js,.jsx,.mjs src/ tests/",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/pack.mjs",
    "release": "node scripts/release.mjs",
    "deps:fonts": "node scripts/fetch-fonts.mjs",
    "verify": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "chrome-extension",
    "anime",
    "newtab",
    "react",
    "wano-arc",
    "one-piece"
  ],
  "author": "AnimeTab Team",
  "license": "UNLICENSED",
  "dependencies": {
    "framer-motion": "^10.16.4",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.52.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "rimraf": "^5.0.1",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "browserslist": [
    "chrome >= 90"
  ]
}
